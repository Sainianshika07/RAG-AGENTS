# Environment Variables - Copy this to .env.local and fill in your values

# ─── Database (SQLite via Prisma) ─────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Google Gemini ───────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# ─── Pinecone ────────────────────────────────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# The name of your Pinecone index (must use "text-embedding-004" dimension = 768)
PINECONE_INDEX_NAME=learn-rag

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32  OR any 32+ char random string
NEXTAUTH_SECRET=your_nextauth_secret_here_min_32_chars

# The URL of your app (use http://localhost:3000 for local dev)
NEXTAUTH_URL=http://localhost:3000
